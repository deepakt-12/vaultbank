# ==============================================================================
# VaultBank Environment Variables Template
# Copy this file to .env and supply environment-specific, high-entropy secrets.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Requires a replica set (local or Atlas) for multi-document ACID transactions
MONGODB_URI=mongodb://localhost:27017/vaultbank?replicaSet=rs0
MONGODB_DB_NAME=vaultbank

# Session & Security Secret (Min 64 characters, cryptographically random)
# Generate with: openssl rand -base64 48
SESSION_SECRET=vaultbank-dev-session-secret-replace-with-at-least-64-random-characters-in-prod
SESSION_NAME=vaultbank.sid
SESSION_MAX_AGE_MS=86400000

# Cookie Security Settings
COOKIE_SECURE=false # Set to true in production behind HTTPS
COOKIE_SAME_SITE=lax # lax or strict
COOKIE_DOMAIN=localhost

# CSRF Protection
CSRF_SECRET=vaultbank-csrf-secret-replace-with-32-chars-random-in-prod

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Password Hashing (Argon2id recommended parameters)
# Time cost (iterations), Memory cost (in KiB), Parallelism
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Simulated Email / Notifications (Console or SMTP)
EMAIL_PROVIDER=console # 'console' for dev/educational testing, 'smtp' for production
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@vaultbank.example.com

# Multi-Factor Authentication (TOTP)
MFA_APP_NAME=VaultBank

# Financial / Ledger Engine Controls
DEFAULT_CURRENCY=USD
MAX_TRANSFER_AMOUNT_CENTS=10000000 # $100,000.00
HIGH_RISK_TRANSFER_THRESHOLD_CENTS=500000 # $5,000.00 requires re-auth/MFA
VELOCITY_MAX_TRANSFERS_PER_HOUR=10

